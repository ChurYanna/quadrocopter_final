        <geom name="gate3_top_beam" type="box" pos="17.0 0.00 8.70" size="0.24 12.74 7.00" material="gate_material_c"/>
        <geom name="gate3_bottom_beam" type="box" pos="17.0 0.00 0.200" size="0.24 12.74 0.200" material="gate_material_c"/>

        <geom name="gate4_left_post" type="box" pos="29.0 -6.63 8.00" size="0.24 6.00 8.00" material="gate_material_d"/>
