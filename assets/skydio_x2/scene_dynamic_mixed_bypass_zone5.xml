        <geom name="gate2_bottom_beam" type="box" pos="11.5 0.00 1.025" size="0.24 12.58 1.025" material="gate_material_b"/>

        <geom name="gate3_left_post" type="box" pos="17.0 -6.74 8.00" size="0.24 6.00 8.00" material="gate_material_c"/>
