    <keyframe>
        <key name="hover"
             qpos="0.0 0.0 0.3 1 0 0 0 0.0 1.0 0.3 1 0 0 0 0.0 -1.0 0.3 1 0 0 0 0.0 2.0 0.3 1 0 0 0 0.0 -2.0 0.3 1 0 0 0"
             ctrl="3.2495625 3.2495625 3.2495625 3.2495625 3.2495625 3.2495625 3.2495625 3.2495625 3.2495625 3.2495625 3.2495625 3.2495625 3.2495625 3.2495625 3.2495625 3.2495625 3.2495625 3.2495625 3.2495625 3.2495625"/>
    </keyframe>

    <sensor>
        <gyro name="q1_body_gyro" site="q1_imu"/>
        <accelerometer name="q1_body_linacc" site="q1_imu"/>
        <framequat name="q1_body_quat" objtype="site" objname="q1_imu"/>

        <gyro name="q2_body_gyro" site="q2_imu"/>
        <accelerometer name="q2_body_linacc" site="q2_imu"/>
        <framequat name="q2_body_quat" objtype="site" objname="q2_imu"/>

        <gyro name="q3_body_gyro" site="q3_imu"/>
        <accelerometer name="q3_body_linacc" site="q3_imu"/>
        <framequat name="q3_body_quat" objtype="site" objname="q3_imu"/>

        <gyro name="q4_body_gyro" site="q4_imu"/>
